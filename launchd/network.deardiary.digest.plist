<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>network.deardiary.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/sops</string>
    <string>exec-env</string>
    <string>/Users/claw/.config/secrets/services.enc.env</string>
    <string>/opt/homebrew/bin/node /Users/claw/Code/digest-bot/src/index.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SOPS_AGE_KEY_FILE</key>
    <string>/Users/claw/.config/sops/age/keys.txt</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/claw/Code/digest-bot</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- launchd gets its OWN file, distinct from the app's LOG_PATH
       (DATA_DIR/digest.log). They must never be the same path again: sharing one
       inode means the app's rename-based rotation moves the file out from under
       launchd's fd, and the crash output that bypasses the logger is exactly what
       then goes missing. This file is the net for whatever escapes the logger — if
       it is non-empty, read it. Durable dir, never /tmp: macOS purges /tmp and
       launchd keeps writing to the now-unlinked inode. -->
  <key>StandardOutPath</key>
  <string>/Users/claw/.local/share/digest/digest-service.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/claw/.local/share/digest/digest-service.log</string>
</dict>
</plist>
