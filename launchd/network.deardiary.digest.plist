<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>network.deardiary.digest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/sops</string>
    <string>exec-env</string>
    <string>/Users/claw/.config/secrets/services.enc.env</string>
    <string>/opt/homebrew/bin/node /Users/claw/Code/digest-bot/src/index.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SOPS_AGE_KEY_FILE</key>
    <string>/Users/claw/.config/sops/age/keys.txt</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/claw/Code/digest-bot</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Durable log path: macOS purges /tmp, and launchd keeps writing to the
       now-unlinked inode, which silently destroys the whole log history.
       Must match LOG_PATH's default in src/config.js (DATA_DIR/digest.log). -->
  <key>StandardOutPath</key>
  <string>/Users/claw/.local/share/digest/digest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/claw/.local/share/digest/digest.log</string>
</dict>
</plist>
