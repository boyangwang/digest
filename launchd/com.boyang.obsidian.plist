<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.boyang.obsidian</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/claw/Code/digest-bot/launchd/obsidian-keepalive.sh</string>
  </array>

  <!-- GUI session required so `open -a Obsidian` can launch the app -->
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/obsidian-keepalive.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/obsidian-keepalive.log</string>
</dict>
</plist>
