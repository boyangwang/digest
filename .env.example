# Copy to .env for local dev (production injects these from the sops vault).
DIGEST_BOT_TOKEN=your_telegram_bot_token_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here        # STT vendor 1
OPENAI_API_KEY=your_openai_api_key_here                # title/tags + captions; STT vendor 2
TENCENT_TOKENHUB_API_KEY=                              # optional, only with DIGEST_LLM_PROVIDERS=...,tokenhub
DIGEST_LARK_APP_ID=cli_xxx                             # Lark "Sleep Digest" app (src/lark-index.js)
DIGEST_LARK_APP_SECRET=your_lark_app_secret_here

# Optional overrides:
# DIGEST_OUT_DIR=/Users/claw/Documents/NotesVault/Heresy-Anthology/digest
# DIGEST_DATA_DIR=$HOME/.local/share/digest
# DIGEST_LLM_PROVIDERS=openai                         # e.g. openai,tokenhub
# DIGEST_TITLE_MODEL=gpt-5.4-mini
# DIGEST_VISION_MODEL=gpt-5.4-mini
# DIGEST_TITLE_REASONING_EFFORT=medium
# DIGEST_LOG_PATH=$HOME/.local/share/digest/digest.log

# Transcription retry/rotation (see src/stt.js). Attempts alternate across the
# vendors in order, so 6 attempts over 2 vendors = 1,2,1,2,1,2.
# DIGEST_STT_PROVIDERS=elevenlabs,openai
# DIGEST_STT_MAX_ATTEMPTS=6
# DIGEST_STT_ATTEMPT_TIMEOUT_MS=180000
# Hard ceiling on one transcribe() call: 6 x 180000ms of request time + the five
# jittered backoff sleeps (<=28750ms) = 1108750ms, so 1110000ms is the binding bound.
# DIGEST_STT_TOTAL_BUDGET_MS=1110000

# Media download (Telegram getFile / Lark resources), same ladder: 5 x 3 min.
# DIGEST_DOWNLOAD_MAX_ATTEMPTS=5
# DIGEST_DOWNLOAD_ATTEMPT_TIMEOUT_MS=180000
# DIGEST_DOWNLOAD_TOTAL_BUDGET_MS=940000
# DIGEST_JOB_PROGRESS_NOTICE_MS=45000      # one "still working" message after this long
# DIGEST_NET_FAMILY_ATTEMPT_TIMEOUT_MS=3000 # per-address connect window (src/net-tuning.js)
# DIGEST_LARK_ALLOWED_OPEN_IDS=ou_...       # default: Boyang's open_id for the Sleep Digest app
# DIGEST_OPENAI_STT_MODEL=gpt-4o-transcribe
# DIGEST_ELEVENLABS_MODEL=scribe_v2

# Title/tag LLM retry ladder (same mechanism, see src/retry.js). Worst case:
# 4 x 90000ms of request time + the three jittered backoff sleeps (<=8750ms) = 368750ms.
# DIGEST_LLM_MAX_ATTEMPTS=4
# DIGEST_LLM_ATTEMPT_TIMEOUT_MS=90000
# DIGEST_LLM_TOTAL_BUDGET_MS=370000

# Log file. It records raw model output on an unparseable response, so it holds
# journal-derived content: created mode 0600 and size-capped. Worst case on disk is
# one active file plus DIGEST_LOG_RETAIN rotated ones = 8 MiB x 13 = 104 MiB.
# DIGEST_LOG_MAX_BYTES=8388608
# DIGEST_LOG_RETAIN=12
