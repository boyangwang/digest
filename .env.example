# Copy to .env for local dev (production injects these from the sops vault).
DIGEST_BOT_TOKEN=your_telegram_bot_token_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here        # STT vendor 1
OPENAI_API_KEY=your_openai_api_key_here                # STT vendor 2 (transcription fallback)
TENCENT_TOKENHUB_API_KEY=your_tencent_tokenhub_api_key_here

# Optional overrides:
# DIGEST_OUT_DIR=/Users/claw/Documents/NotesVault/Heresy-Anthology/digest
# DIGEST_DATA_DIR=$HOME/.local/share/digest
# DIGEST_TITLE_MODEL=glm-5.2
# DIGEST_VISION_MODEL=glm-5v-turbo
# DIGEST_LOG_PATH=$HOME/.local/share/digest/digest.log

# Transcription retry/rotation (see src/stt.js). Attempts alternate across the
# vendors in order, so 6 attempts over 2 vendors = 1,2,1,2,1,2.
# DIGEST_STT_PROVIDERS=elevenlabs,openai
# DIGEST_STT_MAX_ATTEMPTS=6
# DIGEST_STT_ATTEMPT_TIMEOUT_MS=60000
# Hard ceiling on one transcribe() call: 6 x 60000ms of request time + the five
# jittered backoff sleeps (<=28750ms) = 388750ms, so 390000ms is the binding bound.
# DIGEST_STT_TOTAL_BUDGET_MS=390000
# DIGEST_OPENAI_STT_MODEL=gpt-4o-transcribe
# DIGEST_ELEVENLABS_MODEL=scribe_v2
